{
  "env": { "browser": true, "es2022": true, "node": true },
  "globals": {
    "ATS": "readonly",
    "ATS_SKILLS": "readonly",
    "ATSApp": "writable",
    "ATSApi": "readonly",
    "ATSConfig": "readonly",
    "ATSExternalScript": "readonly",
    "ATSFileParser": "readonly",
    "ATSOptimizer": "readonly",
    "ATSSessionStore": "readonly",
    "ResumeIcons": "readonly",
    "ResumeTemplates": "readonly"
  },
  "extends": ["eslint:recommended"],
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "script" },
  "rules": {
    "linebreak-style": ["error", "unix"],
    "no-console": "off",
    "no-var": "error",
    "prefer-const": "error",
    "no-trailing-spaces": "error",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "max-len": ["warn", { "code": 120 }],
    "curly": "off",
    "indent": "off",
    "quotes": "off",
    "eqeqeq": "off",
    "no-useless-escape": "off"
  },
  "overrides": [{ "files": ["**/*.test.js"], "env": { "node": true } }],
  "ignorePatterns": ["Ats resume checker/assets/vendor/", "node_modules/"]
}
