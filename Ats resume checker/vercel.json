{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "clipboard-read=(), clipboard-write=(self), fullscreen=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/vendor/(.*)",
      "destination": "/Ats resume checker/assets/vendor/$1"
    },
    {
      "source": "/resume-templates/(.*)",
      "destination": "/Ats resume checker/resume-templates/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/Ats resume checker/$1"
    }
  ]
}
